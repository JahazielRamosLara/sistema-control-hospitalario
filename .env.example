# Copia a .env para personalizar docker compose
POSTGRES_USER=hospital
POSTGRES_PASSWORD=hospital
DB_PORT=5433
API_PORT=8000
WEB_PORT=8080
SEED_DATOS_EJEMPLO=1
NOMBRE_HOSPITAL=Sistema de Control Hospitalario
# Administrador inicial (se crea solo si no hay usuarios). Si ADMIN_PASSWORD queda vacío,
# se genera una contraseña temporal y se muestra en: docker compose logs backend
ADMIN_USUARIO=admin
ADMIN_PASSWORD=
# Poner en true si la app se publica con HTTPS
COOKIE_SECURE=false
